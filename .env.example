# Base URL of the Django backend API (no trailing "core/")
VITE_API_BASE_URL=http://127.0.0.1:8000/api/

# Base URL of the backend media server (for profile pictures / photos)
VITE_MEDIA_URL=http://127.0.0.1:8000

